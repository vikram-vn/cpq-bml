node_modules/**
.vscode/**
.vscode-test/**
.claude/**
test/**
logs/**
scratch/**
library/**
extension/**
.gitignore
.vscodeignore
.yarnrc
yarn.lock
.cursorrules
package-lock.json
vsc-extension-quickstart.md
**/jsconfig.json
jsconfig.json
**/*.map
.agents/ 
**/eslint.config.mjs
**/.vscode-test.*
cpq/**
cpq
.mocharc.json
*.vsix
*.bml
.github
bml
*.md
!README.md
!CHANGELOG.md
SKILLS.md
requirements.txt
knowledge/**

# Ignore root and raw JavaScript source files (compiled into dist/extension.js)
extension.js
app/**/*.js
!dist/web-panel/**

# Exclude minified CSS and JS from the extension package
*.min.css
*.min.js

# Ignore WebAssembly source and binary files (shipped via cipherWasmBinary.js)
**/*.wat
**/*.wasm

# Ignore raw source folders that are compiled into dist/extension.js
app/lang/beautify/**
app/lang/lint/**
app/lang/rest/**
app/lang/comments/**
app/lang/cloud/*.js
app/lang/graph/*.js
app/lang/settings/*.js
app/lang/web-panel/*.js
app/lang/web-panel/src/**
app/lang/web-panel/css/**
!app/lang/web-panel/index.html
app/lang/snippets/**
app/lang/spell-check/*.br
app/lang/**/README*.md
app/lang/syntaxes/*.json
!app/lang/syntaxes/*.min.json
app/images/**/*.svg
app/lang/xslt/**
app/lang/metrics/**
app/lang/test-controller/**
app/ai/**

# Intellisense JSON: ship only the minified .min.json variants and .br for large catalogs
app/lang/intellisense/**
!app/lang/intellisense/*.min.json.br
!app/lang/intellisense/best-practice-advisories.min.json
!app/lang/intellisense/bml-cpq-js-api-usage.min.json
!app/lang/intellisense/bml-util-attributes-api-usage.min.json
!app/lang/intellisense/bml-variables-api-usage.min.json
!app/lang/intellisense/category-labels.min.json
!app/lang/intellisense/curated-params.min.json
!app/lang/intellisense/custom-snippets.min.json
!app/lang/intellisense/function-param-data-types.min.json
!app/lang/intellisense/function-return-types.min.json
!app/lang/intellisense/keyword-hovers.min.json

# Exclude development scripts
scripts/**

# Themes/grammars: ship only the minified .min.json variants
# (package.json's contributes.themes/grammars paths point at these directly)
themes/*.json
!themes/*.min.json
themes/dark-default.json
themes/dark.json
themes/light-default.json
themes/light.json
app/lang/syntaxes/*.json
!app/lang/syntaxes/*.min.json
app/lang/syntaxes/bml.tmLanguage.json
app/lang/syntaxes/xslt.tmLanguage.json