*.bml
.github
bml
SKILLS.md

# Ignore raw source folders that are compiled into dist/extension.js
app/lang/beautify/**
app/lang/lint/**
app/lang/rest/**

# Ignore spell check JS
app/lang/spellCheck/*.js

# english-words.txt ships brotli-compressed (english-words.txt.br, decompressed at
# runtime by spelling.js); the plain .txt is kept only for dev/regeneration.
app/lang/spellCheck/english-words.txt

#Ignore BML Better Comments extension
app/lang/comments/**

# Ignore MCP JavaScript source files
app/lang/mcp/*.js
app/lang/mcp/tools/*.js

# Ignore root JavaScript source files
extension.js
app/lang/intellisense/*.js
app/lang/settingsPanel/*.js
app/lang/settingsPanel/webview/src/**

# Exclude lookups and scripts that are only used in development
app/lookups/**
scripts/**