node_modules/**
.vscode/**
.vscode-test/**
.claude/**
test/**
logs/**
scratch/**
library/**
extension/**
.gitignore
.vscodeignore
.yarnrc
yarn.lock
.cursorrules
package-lock.json
vsc-extension-quickstart.md
**/jsconfig.json
jsconfig.json
**/*.map
.agents/ 
