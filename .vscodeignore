SKILLS.md
requirements.txt
knowledge/**

# Ignore root and raw JavaScript source files (compiled into dist/extension.js)
extension.js
app/**/*.js
!app/lang/web-panel/dist/main.js
!app/lang/web-panel/settings/dist/main.js
!app/lang/web-panel/interactive/dist/main.js
!app/lang/web-panel/graph/dist/main.js

# Ignore WebAssembly source and binary files (shipped via cipherWasmBinary.js)
**/*.wat
**/*.wasm

# Ignore raw source folders that are compiled into dist/extension.js
app/lang/beautify/**
app/lang/lint/**
app/lang/rest/**
app/lang/comments/**
app/lang/cloud/*.js
app/lang/graph/*.js
app/lang/settings-panel/*.js
app/lang/web-panel/*.js
app/lang/web-panel/src/**
!app/lang/web-panel/dist/**
!app/lang/web-panel/css/**
!app/lang/web-panel/index.html
app/lang/snippets/**
app/lang/spell-check/*.br
app/lang/**/README*.md
app/lang/syntaxes/*.json
!app/lang/syntaxes/*.min.json
app/images/**/*.svg
app/lang/xslt/**
app/lang/metrics/**
app/lang/test-controller/**
app/ai/**

# Intellisense JSON: ship only the minified .min.json variants
# (apiDataLoader.js reads them directly, same pattern as the themes/grammars below).
app/lang/intellisense/*.json
!app/lang/intellisense/*.min.json
app/lang/intellisense/best-practice-advisories.json
app/lang/intellisense/bml-attributes-api-usage.json
app/lang/intellisense/bml-cpq-js-api-usage.json
app/lang/intellisense/bml-functions-api-usage.json
app/lang/intellisense/bml-util-attributes-api-usage.json
app/lang/intellisense/bml-variables-api-usage.json
app/lang/intellisense/category-labels.json
app/lang/intellisense/curated-params.json
app/lang/intellisense/custom-snippets.json
app/lang/intellisense/function-param-data-types.json
app/lang/intellisense/function-return-types.json
app/lang/intellisense/keyword-hovers.json

# Exclude development scripts
scripts/**

# Settings webview CSS: ship only the minified .min.css variants
# (html.js references the .min.css files directly)
app/lang/web-panel/css/settings-main.css
app/lang/web-panel/css/settings-layout.css
app/lang/web-panel/css/settings-components.css

# Themes/grammars: ship only the minified .min.json variants
# (package.json's contributes.themes/grammars paths point at these directly)
themes/*.json
!themes/*.min.json
themes/dark-default.json
themes/dark.json
themes/light-default.json
themes/light.json
app/lang/syntaxes/*.json
!app/lang/syntaxes/*.min.json
app/lang/syntaxes/bml.tmLanguage.json
app/lang/syntaxes/xslt.tmLanguage.json