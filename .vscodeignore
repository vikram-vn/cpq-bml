node_modules/**
.vscode/**
.vscode-test/**
.claude/**
test/**
.gitignore
.vscodeignore
.yarnrc
.cpqdevkit
yarn.lock
package-lock.json
vsc-extension-quickstart.md
**/jsconfig.json
jsconfig.json
**/*.map
**/eslint.config.mjs
**/.vscode-test.*
*.bml
.github
bml
SKILLS.md
requirements.txt
scratch/**

# Ignore root JavaScript source file (bundled into dist/extension.js)
extension.js

# Ignore raw source folders that are compiled into dist/extension.js
app/lang/beautify/**
app/lang/lint/**
app/lang/rest/**
app/lang/comments/**
app/lang/mcp/*.js
app/lang/mcp/tools/*.js
app/lang/intellisense/*.js
app/lang/settingsPanel/*.js
app/lang/settingsPanel/webview/src/**
app/lang/xslt/**
app/lang/metrics/**
app/lang/testing/**

# Ignore spell check JS source and uncompressed dictionary
# (runtime loads english-words.txt.br instead)
app/lang/spellCheck/*.js
app/lang/spellCheck/english-words.txt

# Intellisense JSON: ship only the brotli-compressed .json.br variants
# (apiDataLoader.js decompresses at runtime via Node's built-in zlib)
app/lang/intellisense/*.json

# Exclude lookups and scripts that are only used in development
app/lookups/**
scripts/**

# Knowledge markdown: ship only the brotli-compressed .md.br variants
# (helpViewer.js decompresses at runtime via Node's built-in zlib)
app/knowledge/**/*.md