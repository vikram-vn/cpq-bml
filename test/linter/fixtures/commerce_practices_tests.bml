// ==========================================
// BML Category: COMMERCE PRACTICES - Senior QA Regression Suite
// ==========================================

// 1. Valid Commerce Return Format (no warnings)
retVal1 = "1~price_line~25.50|";
retVal2 = "2~qty_line~10|";

if (true) {
    ret = retVal1 + retVal2;
    return ret;
}

// 2. Banned Config Attributes (bml-config-attr-banned)
badAttr1 = _config_attributes;
badAttr2 = _config_attr_text;
badAttr3 = _CONFIG_ATTRIBUTES;

// 3. Commerce Return Format Delimiter Check (bml-commerce-return-format)
// Multiple doc~var~value triplets glued together without the '|' separator
ret = "1~price_line~25.50" + "1~qty_line~10";

// A single triplet is valid without a trailing '|' - Oracle's own reference
// library returns these bare, the pipe only separates multiple triplets.
return "1~price_line~25.50";
