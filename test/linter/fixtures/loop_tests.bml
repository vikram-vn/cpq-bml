// ==========================================
// BML Category: LOOPS - Senior QA Regression Suite
// ==========================================

// 1. Valid Loops and sequence ranges
validArray = string[]{"A", "B", "C"};
for item in validArray {
    print(item);
}

for index in range(5) {
    print(index);
}

// 2. Empty Loops (bml-empty-loop warnings)
emptyStringArray = string[]{};
for unusedStr in emptyStringArray {
    print("never executes");
}

emptyIntArray = integer[]{};
for unusedInt in emptyIntArray {
    print("never executes");
}

emptyFloatArray = float[]{};
for unusedFloat in emptyFloatArray {
    print("never executes");
}

emptyBoolArray = boolean[]{};
for unusedBool in emptyBoolArray {
    print("never executes");
}

emptyDateArray = date[]{};
for unusedDate in emptyDateArray {
    print("never executes");
}

// 3. Shadowed Loop Variables (bml-shadowed-variable warning)
shadowVar = 100;
for shadowVar in range(3) {
    print(shadowVar);
}

// 4. Invalid range arguments (Syntax error: built-in function range expects 1 argument)
for invalidStep in range(0, 10, 2) {
    print(invalidStep);
}

// 5. Scope Context Violations (bml-loop-control-outside-loop error)
break;
continue;

if (true) {
    break;
    continue;
}

// 6. Valid break and continue inside a loop
for loopControl in range(10) {
    if (loopControl == 5) {
        break;
    }
    if (loopControl == 2) {
        continue;
    }
}

// 7. Performance Violations in Loops (bml-bmql-in-loop, bml-string-concat-in-loop, bml-nested-loop)
for pIdx in range(3) {
    // BMQL inside loop
    perfRs = bmql("select id from parts");
    print(perfRs);
    
    // Nested loop
    for innerIdx in range(2) {
        print(innerIdx);
    }
}

// String concat inside loop
accumulatedStr = "";
for concatIdx in range(3) {
    accumulatedStr = accumulatedStr + "suffix";
}
print(accumulatedStr);

// 8. Deep Nesting Warning (bml-deep-nesting warning at depth > 3)
if (true) {
    if (true) {
        if (true) {
            for deepVar in range(1) {
                print(deepVar);
            }
        }
    }
}

// 9. Unused loop variable (bml-unused-loop-var info)
for unusedLoopVar in range(2) {
    print("looping without using var");
}

return "";
