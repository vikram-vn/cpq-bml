// ==========================================
// BML Category: SAFETY - Senior QA Regression Suite
// ==========================================

// 1. Null Safety checks (bml-null-check-required)
// Valid: Guarded nullable source references
rsSafe = bmql("select id from parts where type = 'A'");
if (sizeofarray(rsSafe) > 0) {
    print(rsSafe);
}

// Invalid: Unguarded nullable source references
rsUnsafe = bmql("select id from parts where type = 'B'");
print(rsUnsafe); // Unguarded usage
exprResult = rsUnsafe + "_suffix"; // Unguarded in expression

// 2. isnumber checks before atoi/atof (bml-unsafe-atoi-atof)
// Valid: Guarded type conversion
sNumSafe = "42";
if (isnumber(sNumSafe)) {
    valIntSafe = atoi(sNumSafe);
}

// Invalid: Unguarded type conversion
sNumUnsafe = "42";
valIntUnsafe = atoi(sNumUnsafe);
valFltUnsafe = atof(sNumUnsafe);

// 3. Checked split array access (bml-unchecked-split-access)
// Valid: Guarded access
partsListSafe = split("a,b,c", ",");
if (sizeofarray(partsListSafe) > 0) {
    p1 = partsListSafe[0];
}

// Invalid: Unguarded access
partsListUnsafe = split("a,b,c", ",");
p2 = partsListUnsafe[0];

// 4. dict() type arguments (bml-dict-missing-type)
// Valid
dictOK = dict("string");
// Invalid
dictErr = dict();

// 5. Division by zero (bml-division-by-zero)
zeroDiv1 = 100 / 0;
zeroDiv2 = 5.5 / 0.0;

// 6. Direct float equality (bml-float-equality)
floatVal = 10.5;
if (floatVal == 10.5) {
    print("Direct float comparison");
}
if (floatVal != 20.5) {
    print("Direct float comparison");
}
if (floatVal <> 30.5) {
    print("Direct float comparison");
}

// 7. Invalid character patterns (e.g. ASCII control chars)
corruptData = "corrupt\x1cvalue";

return "";
