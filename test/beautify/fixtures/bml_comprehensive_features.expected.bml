// 1. Array Declarations of various types
intArray = Integer[] {1, 2, 3, 4, 5};
strArray = String[] {"hello", "world"};
floatArray = Float[] {1.5, 2.75};
boolArray = Boolean[] {true, false};

// 2. Chained/Nested operators and arithmetic
total = 10 + 5 * 2 - (4 / 2) % 3;
flag = (total > 15 AND total <= 25) OR NOT(total == 20);

// 3. String quotes and escapes
singleQuoteStr = 'This is a \'single\' quoted string';
doubleQuoteStr = "This is a \"double\" quoted string";

// 4. Dictionary and built-ins
myDict = dict("string");
put(myDict, "key", "value");
if (containsKey(myDict, "key")) {
	val = get(myDict, "key");
	remove(myDict, "key");
}

// 5. Loop with break and continue
for num in intArray {
	if (num == 2) {
		continue;
	}
	if (num == 4) {
		break;
	}
	print(string(num));
}

// 6. Block comments and return statement
/*
 * End of the comprehensive BML script
 */
return "done";