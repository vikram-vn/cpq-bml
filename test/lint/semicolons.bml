// Good statements (no missing semicolons)
x = 10;
print(x);

// Missing semicolons (should be flagged)
y = 20
z = 30

// Multi-line statement continuation with operators (no missing semicolon)
total = 10 +
        20 +
        30;

// Multi-line statement continuation with parenthesis (no missing semicolon)
ret = "a" + string(
    estimatePrice
) + "|";

// Control statements with comments (no missing semicolon)
if (x == 10) // check x
{
    print(x);
} else // check else
{
    print(0);
}

for item in listList // check for
{
    print(item);
}

// Block comment with code (should flag missing semicolon)
/* block comment */ a = 40
return "";
