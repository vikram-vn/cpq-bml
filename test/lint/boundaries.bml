// 1. Special corrupting character (0x1c FS)
charFS = "";

// 2. BMQL Schema Limits (Table & Column Name Lengths)
results = bmql("select my_extremely_long_column_name_that_exceeds_twenty_characters from table_name_that_is_exceedingly_long_exceeds_twenty");

// 3. Numeric bounds and limits
i1 = 2147483648; // integer overflow
i2 = -2147483649; // integer underflow
i3 = 1000000000; // exceeds 999,999,999
f1 = 1.2345678901234567; // >16 digits precision
f2 = 1.2345678; // >6 decimal places
c1 = 100000000000000.0; // >90 trillion currency limit

// 4. String literal limits
// A string of 256 characters
s256 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";

// A string of 257 characters
s257 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";

// A string of 4001 characters
s4001 = "";

// Usage to prevent unused variable warnings
print(charFS);
print(results);
print(i1);
print(i2);
print(i3);
print(f1);
print(f2);
print(c1);
print(s256);
print(s257);
print(s4001);
return "";
