// Leap year calculations
dateFeb28 = strtojavadate("2024-02-28", "%Y-%m-%d");
dateFeb29 = adddays(dateFeb28, 1);
dateMarch1 = adddays(dateFeb28, 2);
dateNonLeapFeb28 = strtojavadate("2023-02-28", "%Y-%m-%d");
dateNonLeapMarch1 = adddays(dateNonLeapFeb28, 1);

// Date parsing formats
parsedDate1 = strtojavadate("2026-07-03", "%Y-%m-%d");
parsedDate2 = strtojavadate("03/07/2026", "%d/%m/%Y");
parsedDate3 = strtojavadate("07-03-2026 21:55:00", "%m-%d-%Y %H:%M:%S");

// Negative and zero day/month additions
backwardsDate = adddays(getdate(), -30);
backwardsMonth = addmonths(getdate(), -12);
zeroDaysAdded = adddays(getdate(), 0);
zeroMonthsAdded = addmonths(getdate(), 0);

// Business milestone comparisons
orderDate = getdate();
expirationDate = adddays(orderDate, 30);
if (expirationDate > adddays(orderDate, 30)) {
    print("Expired milestone");
}

// Timezone DST changes offset comparisons
dstDate1 = strtojavadate("2026-03-08 02:00:00", "%Y-%m-%d %H:%M:%S");
dstDate2 = strtojavadate("2026-11-01 02:00:00", "%Y-%m-%d %H:%M:%S");

// Extreme Epoch boundaries
epochStart = getcurrenttimeinmillis();
epochOld = getcurrenttimeinmillis();
return "";
