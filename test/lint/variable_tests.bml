// Local variables and scopes
listPrice = 100.0;
print(listPrice);

// Invalid: Unused variables
unusedRootPrice = 200.0;
unusedDiscountVal = 10.0;
if (listPrice > 50.0) {
    unusedIfVariable = "unused";
}

// Invalid: Variable shadowing (inner variable redeclaration)
shadowedVar = 5;
if (true) {
    shadowedVar = 10;
    print(shadowedVar);
}

// Invalid: Use before define
print(declaredLate);
declaredLate = "declared now";

return "";
