// ==========================================
// BML Category: UNUSED & SHADOWING & USE BEFORE DEFINE - Senior QA Regression Suite
// ==========================================

// 1. Unused Variable Warnings (bml-unused-variable)
unusedLocal = 123;

// Ignored/exempt unused variables (no warnings expected)
dummy = "ignored";
temp = "ignored";
trigger_event = "ignored";
unused = "ignored";

// 2. Unused Loop Variable (bml-unused-loop-var)
for unusedLoopVar in range(3) {
    print("loop variable is not used");
}

// 3. Loop Shadowing warning (bml-shadowed-variable)
shadowedVar = 10;
for shadowedVar in range(3) {
    print(shadowedVar);
}

// 4. Use Before Define Warning (bml-useBeforeDefine)
print(declaredLateVar);
declaredLateVar = "defined here";

// 5. BMQL dynamic variable usage ($varName in BMQL string literals)
testBmqlVar = "123";
bmqlRes = bmql("SELECT part_number FROM c_parts WHERE status = $testBmqlVar");

// 6. BMQL dynamic variable referencing undeclared variable ($test2)
bmqlErrRes = bmql("SELECT part_number FROM c_parts WHERE status = $test2");

return "";
