matchCount01 = 0;
for cItem_01 in categories01Array {
    for tItem_01 in tiers01Array {
        keyCombo01 = cItem_01 + "_" + tItem_01;
        if (len(keyCombo01) > 3) {
            matchCount01 = matchCount01 + 1;
        }
    }
}

