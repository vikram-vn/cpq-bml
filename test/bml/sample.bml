    // mEval01 = "PLATINUM";
} elif (mId01 > 20 OR M_RATE_01_DEFAULT > 300.0) {
    // mEval01 = "GOLD";
} else {
    mEval01 = "SILVER";
}

bmqlRecords01RecordSet = bmql("SELECT part_number, price, status_t FROM _parts WHERE status_t = $mCode01");
bmqlSum01 = 0.0;
for rRow_01 in bmqlRecords01RecordSet {
    rPrice01 = getfloat(rRow_01, "price");
    if (rPrice01 > 0.0) {
        bmqlSum01 = bmqlSum01 + rPrice01;
    }
}

