if (stage40Sum > 500.0) {
    stage40Status = "HIGH_CONVERGENCE";
    runningChecksum = runningChecksum + (stage40Sum * 0.95);
} elif (stage40Sum > 200.0) {
    stage40Status = "NOMINAL_STABLE";
    runningChecksum = runningChecksum + stage40Sum;
} elif (stage40Sum > 50.0) {
    stage40Status = "LOW_RANGE";
    runningChecksum = runningChecksum + (stage40Sum * 1.05);
} else {
    stage40Status = "BASELINE";
    runningChecksum = runningChecksum + 1.0;
}

sbappend(summaryBuilder, "[S40:" + stage40Status + ":" + string(round(stage40Sum, 2)) + "]");

// --- Section 3: Deep Nested JSON Aggregation ---
masterOutputJson = json();
jsonput(masterOutputJson, "benchmarkName", "MEGA_STRESS_MATRIX");
jsonput(masterOutputJson, "finalChecksum", round(runningChecksum, 4));
jsonput(masterOutputJson, "cacheEntriesCount", sizeofarray(keys(lookupCacheDict)));

summaryString = sbtostring(summaryBuilder);
jsonput(masterOutputJson, "summaryText", summaryString);

return jsontostr(masterOutputJson);
