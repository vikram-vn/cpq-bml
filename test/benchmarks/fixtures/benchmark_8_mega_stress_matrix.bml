// --- Section 1: Global Setup and Array Constructors ---
matrixDim = 25;
gridValues2D = float[][];
lookupCacheDict = dict("float");
summaryBuilder = stringbuilder("MEGA_STRESS_REPORT:");
runningChecksum = 0.0;
stepIndicesList = range(20);

// --- Stage 1: Matrix Processing Pipeline Block ---
stage1ValuesList = float[];
stage1LabelsList = string[];
stage1Sum = 0.0;
stage1Weight = 0.625;

for idx in stepIndicesList {
    baseVal = float(idx) * stage1Weight + 1.5;
    transformedVal = sqrt(abs(baseVal)) * log(baseVal + 2.0);
    append(stage1ValuesList, transformedVal);
    append(stage1LabelsList, "TAG_" + string(idx) + "_S1");
    stage1Sum = stage1Sum + transformedVal;
    put(lookupCacheDict, "KEY_S1_" + string(idx), transformedVal);
}

// Condition and Branch Stress for Stage 1
if (stage1Sum > 500.0) {
    stage1Status = "HIGH_CONVERGENCE";
    runningChecksum = runningChecksum + (stage1Sum * 0.95);
} elif (stage1Sum > 200.0) {
    stage1Status = "NOMINAL_STABLE";
    runningChecksum = runningChecksum + stage1Sum;
} elif (stage1Sum > 50.0) {
    stage1Status = "LOW_RANGE";
    runningChecksum = runningChecksum + (stage1Sum * 1.05);
} else {
    stage1Status = "BASELINE";
    runningChecksum = runningChecksum + 1.0;
}

sbappend(summaryBuilder, "[S1:" + stage1Status + ":" + string(round(stage1Sum, 2)) + "]");

