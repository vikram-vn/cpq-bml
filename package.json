{
  "name": "cpq-bml",
  "displayName": "CPQ-BML",
  "publisher": "vikram-n",
  "description": "CPQ-BML adds syntax highlighting and reusable code snippets for BigMachines Language (BML) used in CPQ Cloud.",
  "version": "1.89.0",
  "icon": "app/icons/logo.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vikram-vn/cpq-bml.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "workspaceContains:**/*.bml",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "cpq-bml": "./bin/cpq-bml.js"
  },
  "contributes": {
    "debuggers": [
      {
        "type": "bml",
        "label": "BML Debugger",
        "languages": [
          "bml"
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "cpqBml.dataTableEditor",
        "displayName": "CPQ Data Table Editor",
        "selector": [
          {
            "filenamePattern": "*.dt.json"
          },
          {
            "filenamePattern": "*.dt.csv"
          }
        ]
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "cpqBml.mcpServers",
        "label": "CPQ-BML MCP Server"
      }
    ],
    "chatParticipants": [
      {
        "id": "cpqBml.bmlAssistant",
        "name": "bml",
        "fullName": "CPQ-BML Assistant",
        "description": "Oracle CPQ BML specialist for BML code, BMQL, REST APIs, and MCP tools.",
        "isSticky": true
      }
    ],
    "languageModelTools": [
      {
        "name": "cpq_bml_active_environment",
        "displayName": "Active CPQ Environment",
        "toolReferenceName": "cpqEnv",
        "canBeReferencedInPrompt": true,
        "modelDescription": "Returns active Oracle CPQ environment URL and authentication status.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cpq-bml-sidebar",
          "title": "Oracle CPQ Cloud",
          "icon": "app/icons/bml.svg"
        }
      ]
    },
    "views": {
      "cpq-bml-sidebar": [
        {
          "id": "cpqBml.cloudExplorer",
          "name": "Cloud Functions Explorer"
        },
        {
          "id": "cpqBml.cloudDataTables",
          "name": "CPQ Data Tables"
        }
      ]
    },
    "languages": [
      {
        "id": "bml",
        "aliases": [
          "BML",
          "bml",
          "BigMachines Language",
          "BigMachines Markup Language"
        ],
        "extensions": [
          ".bml",
          ".bmlt"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "dark": "./app/icons/bml.svg",
          "light": "./app/icons/bml.svg"
        }
      },
      {
        "id": "xsl",
        "aliases": [
          "XSLT",
          "xsl",
          "xslt"
        ],
        "extensions": [
          ".xsl",
          ".xslt"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "bml",
        "scopeName": "source.bml",
        "path": "./app/lang/syntaxes/bml.tmLanguage.min.json"
      },
      {
        "language": "xsl",
        "scopeName": "source.xsl",
        "path": "./app/lang/syntaxes/xslt.tmLanguage.min.json"
      }
    ],
    "iconThemes": [
      {
        "id": "bml-icon-theme",
        "label": "BML Icon Theme",
        "path": "./themes/bml-icons.min.json"
      }
    ],
    "configurationDefaults": {
      "workbench.iconTheme": "bml-icon-theme"
    },
    "themes": [
      {
        "label": "BML Dark Default",
        "uiTheme": "vs-dark",
        "path": "./themes/dark-default.min.json"
      },
      {
        "label": "BML Light Default",
        "uiTheme": "vs",
        "path": "./themes/light-default.min.json"
      },
      {
        "label": "BML Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/dark.min.json"
      },
      {
        "label": "BML Light",
        "uiTheme": "vs",
        "path": "./themes/light.min.json"
      }
    ],
    "snippets": [],
    "commands": [
      {
        "command": "cpqBml.introspectSchema",
        "title": "CPQ-BML: Introspect Instance Schema & Custom Attributes"
      },
      {
        "command": "cpqBml.openScratchpad",
        "title": "CPQ-BML: Open BML Logic Scratchpad (Offline Sandbox)"
      },
      {
        "command": "cpqBml.runBmlLocally",
        "title": "CPQ-BML: Run BML Script Locally (Scratchpad)"
      },
      {
        "command": "cpqBml.scaffoldLibraryFunction",
        "title": "CPQ-BML: Scaffold New Library Function (with -meta.json sidecar)"
      },
      {
        "command": "cpqBml.scaffoldBmqlQuery",
        "title": "CPQ-BML: Scaffold Parameterized BMQL Query"
      },
      {
        "command": "cpqBml.switchEnvironment",
        "title": "CPQ-BML: Switch Active CPQ Environment"
      },
      {
        "command": "cpqBml.exportTeamProfiles",
        "title": "CPQ-BML: Export Team Profiles (.cpq/profiles.json)"
      },
      {
        "command": "cpqBml.importTeamProfiles",
        "title": "CPQ-BML: Import Team Profiles"
      },
      {
        "command": "cpqBml.activateIconTheme",
        "title": "CPQ-BML: Activate BML Material Icon Theme"
      },
      {
        "command": "cpqBml.rest.setPassword",
        "title": "CPQ-BML: Set CPQ Password"
      },
      {
        "command": "cpqBml.rest.setAuthToken",
        "title": "CPQ-BML: Set CPQ Auth Token"
      },
      {
        "command": "cpqBml.rest.pullLibraryFunctions",
        "title": "CPQ-BML: Pull Util Library Functions from CPQ",
        "icon": "app/icons/pull.svg"
      },
      {
        "command": "cpqBml.rest.pullCommerceFunctions",
        "title": "CPQ-BML: Pull Commerce Functions from CPQ",
        "icon": "app/icons/pull.svg"
      },
      {
        "command": "cpqBml.rest.validateCurrentFile",
        "title": "CPQ-BML: Validate Current File Against CPQ",
        "icon": "app/icons/validate.svg"
      },
      {
        "command": "cpqBml.rest.debugCurrentFile",
        "title": "CPQ-BML: Debug Current Function on CPQ",
        "icon": "app/icons/debug.svg"
      },
      {
        "command": "cpqBml.rest.saveCurrentFile",
        "title": "CPQ-BML: Save Current File to CPQ",
        "icon": "app/icons/save.svg"
      },
      {
        "command": "cpqBml.rest.clearResults",
        "title": "CPQ-BML: Clear Results Terminal",
        "icon": "app/icons/clear.svg"
      },
      {
        "command": "cpqBml.rest.createOverride",
        "title": "CPQ-BML: Create Override",
        "icon": "app/icons/create-override.svg"
      },
      {
        "command": "cpqBml.rest.removeOverride",
        "title": "CPQ-BML: Remove Override",
        "icon": "app/icons/remove-override.svg"
      },
      {
        "command": "cpqBml.rest.deployCommerceProcess",
        "title": "CPQ-BML: Deploy Commerce Process Setup",
        "icon": "app/icons/deploy-commerce.svg"
      },
      {
        "command": "cpqBml.rest.deployCurrentFile",
        "title": "CPQ-BML: Deploy Current Util Function to CPQ",
        "icon": "app/icons/deploy.svg"
      },
      {
        "command": "cpqBml.rest.deployUtilFunctions",
        "title": "CPQ-BML: Mass Deploy Util Library Functions",
        "icon": "app/icons/deploy-mass.svg"
      },
      {
        "command": "cpqBml.rest.createBmlFunction",
        "title": "CPQ-BML: Create BML Function",
        "icon": "app/icons/create-bml.svg"
      },
      {
        "command": "cpqBml.rest.changeEnvironment",
        "title": "CPQ-BML: Change Environment",
        "icon": "app/icons/change-env.svg"
      },
      {
        "command": "cpqBml.rest.globalSearchBml",
        "title": "CPQ-BML: Global Search BML Scripts on CPQ",
        "icon": "$(search)"
      },
      {
        "command": "cpqBml.rest.getTransactions",
