      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cpqBml.rest.syncCommerceMetadata",
          "when": "resourceLangId == bml && !cpqBml.commerceMetadataSynced && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@0"
        },
        {
          "command": "cpqBml.rest.createOverride",
          "when": "resourceLangId == bml && cpqBml.activeFileIsStandard && !cpqBml.activeFileIsOverridden && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@1"
        },
        {
          "command": "cpqBml.rest.removeOverride",
          "when": "resourceLangId == bml && cpqBml.activeFileIsStandard && cpqBml.activeFileIsOverridden && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@1"
        },
        {
          "command": "cpqBml.rest.saveCurrentFile",
          "when": "resourceLangId == bml && (!cpqBml.activeFileIsStandard || cpqBml.activeFileIsOverridden) && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@2"
        },
        {
          "command": "cpqBml.rest.validateCurrentFile",
          "when": "resourceLangId == bml && (!cpqBml.activeFileIsStandard || cpqBml.activeFileIsOverridden) && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@3"
        },
        {
          "command": "cpqBml.rest.debugCurrentFile",
          "when": "resourceLangId == bml && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@4"
        },
        {
          "command": "cpqBml.rest.deployCommerceProcess",
          "when": "resourceLangId == bml && cpqBml.activeFileIsCommerce && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@5"
        },
        {
          "command": "cpqBml.rest.deployCurrentFile",
          "when": "resourceLangId == bml && cpqBml.activeFileIsUtil && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@5"
        },
        {
          "command": "cpqBml.rest.clearResults",
          "when": "resourceLangId == bml && config.cpqBml.connection.enabled && cpqBml.connection.configured",
          "group": "navigation@6"
        },
        {
          "command": "cpqBml.settings.open",
          "when": "resourceLangId == bml",
          "group": "navigation@7"
        }
      ],
      "explorer/context": [
        {
          "command": "cpqBml.inferDataTableSchema",
          "when": "resourceExtname == .csv",
          "group": "7_modification"
        }
      ],
      "view/title": [
        {
          "command": "cpqBml.cloud.refresh",
          "when": "view == cpqBml.cloudExplorer",
          "group": "navigation@1"
        },
        {
          "command": "cpqBml.cloud.syncDefinitions",
          "when": "view == cpqBml.cloudExplorer",
          "group": "navigation@2"
        },
        {
          "command": "cpqBml.cloud.refreshDataTables",
          "when": "view == cpqBml.cloudDataTables",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "cpqBml.cloud.pullFunction",
          "when": "view == cpqBml.cloudExplorer && viewItem == cpqCloudFunctionRemote",
          "group": "inline"
        },
        {
          "command": "cpqBml.cloud.diffFunction",
          "when": "view == cpqBml.cloudExplorer && viewItem == cpqCloudFunctionSynced",
          "group": "inline"
        },
        {
          "command": "cpqBml.cloud.queryDataTable",
          "when": "view == cpqBml.cloudDataTables && viewItem == cpqCloudDataTable",
          "group": "inline@1"
        },
        {
          "command": "cpqBml.cloud.exportDataTableCsv",
          "when": "view == cpqBml.cloudDataTables && viewItem == cpqCloudDataTable",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "CPQ-BML",
      "properties": {
        "cpqBml.connection.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Oracle CPQ REST features. If disabled, settings onboarding will be suppressed and all REST toolbar icons will be hidden from the editor title bar."
        },
        "cpqBml.connection.siteUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your Oracle CPQ instance. Accepts a bare sitename, host, or full URL. Or open the custom settings dashboard: [Open Settings Webview](command:cpqBml.settings.open?%5B%22connection%22%5D)"
        },
        "cpqBml.connection.authMethod": {
          "type": "string",
          "enum": [
            "basic",
            "bearer"
          ],
          "default": "basic",
          "description": "Authentication method for CPQ REST calls: 'basic' (username/password) or 'bearer' (an OAuth/SAML token you already have)."
        },
        "cpqBml.connection.username": {
          "type": "string",
          "default": "",
          "description": "Username for Basic authentication. The password/token itself is never stored here - use the 'CPQ-BML: Set CPQ Password' / 'Set CPQ Auth Token' commands, which store it securely via VS Code Secret Storage."
        },
        "cpqBml.connection.environments": {
          "type": "array",
          "default": [],
          "markdownDescription": "Configure multiple CPQ environments to switch between them quickly. Or manage them in the custom settings dashboard: [Open Settings Webview](command:cpqBml.settings.open?%5B%22environments%22%5D),",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "The custom name of the environment (e.g. dev, test, prod)."
              },
              "siteUrl": {
                "type": "string",
                "description": "The URL of the CPQ instance (e.g. sitename or sitename.bigmachines.com)."
              },
              "username": {
                "type": "string",
                "description": "The username for this environment."
              },
              "authMethod": {
                "type": "string",
                "enum": [
                  "basic",
                  "bearer"
                ],
                "default": "basic",
                "description": "Authentication method: basic or bearer."
              }
            },
            "required": [
              "name",
              "siteUrl"
            ]
          }
        },
        "cpqBml.rest.restVersion": {
          "type": "string",
          "default": "v18",
          "description": "Oracle CPQ REST API version segment used when building request paths, e.g. v18 -> /rest/v18/bml/library/functions."
        },
        "cpqBml.rest.commerceProcess": {
          "type": "string",
          "default": "oraclecpqo",
          "description": "Commerce Process variable name used for commerce BML REST operations."
        },
        "cpqBml.rest.commerceDocument": {
          "type": "string",
          "default": "transaction",
          "description": "Commerce Process document variable name used by 'CPQ-BML: Pull Commerce Functions from CPQ' (e.g. 'transaction'). Change this if your commerce process functions live under a different document."
        },
        "cpqBml.rest.pullFolder": {
          "type": "string",
          "default": "library",
          "description": "Workspace-relative folder where 'CPQ-BML: Pull Util Library Functions from CPQ' saves local .bml files and their -meta.json sidecars. Validate/Deploy/Debug also look for these next to whichever .bml file is open, and fall back to searching the live CPQ library by filename if none is found."
        },
        "cpqBml.features.lint": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML linting (diagnostics and quick fixes). Individual lines or whole files can still be excluded with // bml-lint-disable comments regardless of this setting."
        },
        "cpqBml.features.comments": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML Better Comments: colorizes tagged comments (TODO/FIXME/!/?/* etc), highlights functional directive comments (// bml-lint-disable*, /* beautify ignore:start/end */) distinctly, and styles docHeader comment blocks (Function Name/Description/Inputs/Return)."
        },
        "cpqBml.features.spelling": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML spelling checker (checks spelling in comments, identifiers, and string literals using custom and English dictionaries)."
        },
        "cpqBml.spelling.userWords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Custom words to ignore during BML spelling checks."
        },
        "cpqBml.features.beautifier": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML code formatting / beautification support."
        },
        "cpqBml.features.intellisense": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML autocomplete, hover, signature help, go-to-definition, find references, rename, and document symbols."
        },
        "cpqBml.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable inline parameter name inlay hints for BML function calls."
        },
        "cpqBml.inlayHints.suppressWhenArgumentMatchesName": {
          "type": "boolean",
          "default": true,
          "description": "Suppress inlay hints when the passed argument matches the parameter name (e.g. avoid showing redundant 'record: record')."
        },
        "cpqBml.inlayHints.minimumParameters": {
          "type": "number",
          "default": 1,
          "description": "Minimum number of parameters a function must accept before inlay hints are shown."
        },
        "cpqBml.inlayHints.variableTypes.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable inferred variable type inlay hints for BML variable assignment statements."
        },
        "cpqBml.features.docHeader": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML automatic doc-header completion (triggered by typing '///')."
        },
        "cpqBml.features.xslt": {
          "type": "boolean",
          "default": true,
          "description": "Enable XSLT formatting support."
        },
        "cpqBml.features.metrics": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML code complexity metrics and HTML dashboard report."
        },
        "cpqBml.features.testing": {
          "type": "boolean",
          "default": true,
          "description": "Enable BML unit test runner and snapshot testing."
        },
        "cpqBml.mcp.enable": {
          "type": "boolean",
          "default": false,
          "description": "Start a local MCP (Model Context Protocol) server so an AI agent (e.g. Claude Code) can call CPQ-BML's pull/save/validate/debug/deploy operations directly. The server only binds to 127.0.0.1 (this machine only) and never exposes your CPQ credentials to the connecting client - only the extension itself builds the Authorization header. Run 'CPQ-BML: Show MCP Server Connection Info' for the connection URL."
        },
        "cpqBml.mcp.port": {
          "type": "number",
          "default": 47821,
          "description": "Localhost port the MCP server listens on, when cpqBml.mcp.enable is true."
        },
        "cpqBml.mcp.logToTerminal": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, every MCP tool call (list/pull/save/validate/debug/deploy/create) streams its progress into a dedicated 'CPQ-BML (AI)' integrated terminal, so you can watch what an AI agent is doing to your CPQ instance in real time. Off by default; the same log is always included in each tool's result regardless of this setting."
        },
        "cpqBml.debug.logRestDetails": {
          "type": "boolean",
          "default": false,
          "description": "Log CPQ REST request/response details to a local 'bml_rest_api.log' file in the workspace root."
        },
        "cpqBml.debug.logOutputToFile": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, saves debug output to two files in the workspace root after each BML debug run: 'bml_debug_output.log' (script return value) and 'bml_debug_print.log' (print statements). Disabled by default."
        },
        "cpqBml.debug.showResultsAsTable": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, formats JSON or dictionary return values in BML debug output as a key-value table. Disabled by default."
        },
        "cpqBml.debug.concurrency": {
          "type": "integer",
          "default": 2,
          "enum": [2, 3, 4, 5, 6, 7, 8, 9, 10],
          "minimum": 2,
          "maximum": 10,
          "description": "Number of transactions to debug simultaneously in parallel (min 2, max 10). Default is 2."
        }
      }
    }
  },
  "scripts": {
    "audit": "node ./bin/cpq-bml.js audit .",
    "compile": "node scripts/build/compile.js",
    "watch": "esbuild extension.js --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --sourcemap --watch",
    "vscode:prepublish": "node scripts/build/compile.js --production",
    "package": "node scripts/build/package.js",
    "publish": "npx @vscode/vsce publish --no-yarn --no-dependencies --allow-missing-repository --skip-license",
    "crawl:docs": "python scripts/docs/bml_crawler/crawler.py",
    "crawl:cpq": "python scripts/docs/crawl_cpq_words.py",
    "generate:intellisense": "python scripts/bml_intellisense/generate_intellisense.py",
    "generate:docs": "npm run crawl:docs && npm run generate:intellisense",
    "generate:icons": "node scripts/generate/generate_dynamic_icons.js",
    "build": "npm run package",
    "release": "python scripts/release/release.py",
    "pretest": "npm run compile",
    "test": "vscode-test",
    "test:benchmark": "vscode-test test/linter/scripts/benchmark.test.js",
    "benchmark": "python scripts/benchmarks/run_all.py",
    "benchmark:run": "python scripts/benchmarks/run_all.py",
    "benchmark:intellisense": "python scripts/benchmarks/bench_intellisense.py",
    "benchmark:linter": "python scripts/benchmarks/bench_linter.py",
    "benchmark:beautifier": "python scripts/benchmarks/bench_beautifier.py",
    "benchmark:comments": "python scripts/benchmarks/bench_comments.py",
    "benchmark:metrics": "python scripts/benchmarks/bench_metrics.py",
    "benchmark:icons": "node scripts/benchmarks/bench_dynamic_icons.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
