    "statusBar.foreground": "#4B4F66",
    "statusBar.noFolderBackground": "#F0F0F4",
    "statusBar.debuggingBackground": "#7C5CBF",
    "statusBar.debuggingForeground": "#FAFAFC",
    "titleBar.activeBackground": "#F0F0F4",
    "titleBar.activeForeground": "#1A1A2E",
    "titleBar.inactiveBackground": "#F0F0F4",
    "titleBar.inactiveForeground": "#A0A0B8",
    "tab.activeBackground": "#FAFAFC",
    "tab.activeForeground": "#1A1A2E",
    "tab.activeBorderTop": "#3B5BDB",
    "tab.inactiveBackground": "#F0F0F4",
    "tab.inactiveForeground": "#A0A0B8",
    "tab.border": "#F0F0F4",
    "editorGroupHeader.tabsBackground": "#F0F0F4",
    "panel.background": "#F0F0F4",
    "panel.border": "#FAFAFC",
    "panelTitle.activeForeground": "#1A1A2E",
    "panelTitle.activeBorder": "#3B5BDB",
    "terminal.background": "#F0F0F4",
    "terminal.foreground": "#1A1A2E",
    "terminal.ansiBlack": "#F0F0F4",
    "terminal.ansiRed": "#C2255C",
    "terminal.ansiGreen": "#2F9E44",
    "terminal.ansiYellow": "#A36F00",
    "terminal.ansiBlue": "#3B5BDB",
    "terminal.ansiMagenta": "#7C5CBF",
    "terminal.ansiCyan": "#0B7285",
    "terminal.ansiWhite": "#1A1A2E",
    "terminal.ansiBrightBlack": "#A0A0B8",
    "terminal.ansiBrightRed": "#C2255C",
    "terminal.ansiBrightGreen": "#2F9E44",
    "terminal.ansiBrightYellow": "#A36F00",
    "terminal.ansiBrightBlue": "#3B5BDB",
    "terminal.ansiBrightMagenta": "#7C5CBF",
    "terminal.ansiBrightCyan": "#0B98AB",
    "terminal.ansiBrightWhite": "#0A0A14",
    "scrollbarSlider.background": "#C7C9DC80",
    "scrollbarSlider.hoverBackground": "#C7C9DCB0",
    "scrollbarSlider.activeBackground": "#C7C9DCE0",
    "button.background": "#3B5BDB",
    "button.foreground": "#FAFAFC",
    "button.hoverBackground": "#2F49B8",
    "button.secondaryBackground": "#D0D7F5",
    "button.secondaryForeground": "#1A1A2E",
    "input.background": "#FFFFFF",
    "input.foreground": "#1A1A2E",
    "input.border": "#D5D7E3",
    "input.placeholderForeground": "#A0A0B8",
    "inputOption.activeBorder": "#3B5BDB",
    "dropdown.background": "#FFFFFF",
    "dropdown.foreground": "#1A1A2E",
    "dropdown.border": "#D5D7E3",
    "list.activeSelectionBackground": "#D0D7F5",
    "list.activeSelectionForeground": "#1A1A2E",
    "list.hoverBackground": "#F0F1F8",
    "list.inactiveSelectionBackground": "#F0F1F8",
    "list.highlightForeground": "#3B5BDB",
    "focusBorder": "#A8B4E8",
    "badge.background": "#3B5BDB",
    "badge.foreground": "#FAFAFC",
    "progressBar.background": "#3B5BDB",
    "gitDecoration.addedResourceForeground": "#2F9E44",
    "gitDecoration.modifiedResourceForeground": "#A36F00",
    "gitDecoration.deletedResourceForeground": "#C2255C",
    "gitDecoration.untrackedResourceForeground": "#2F9E44",
    "gitDecoration.ignoredResourceForeground": "#A0A0B8",
    "gitDecoration.conflictingResourceForeground": "#C2255C",
    "diffEditor.insertedTextBackground": "#2F9E4422",
    "diffEditor.removedTextBackground": "#C2255C22",
    "peekView.border": "#3B5BDB",
    "peekViewEditor.background": "#F0F0F4",
    "peekViewResult.background": "#F0F0F4",
    "peekViewTitle.background": "#FAFAFC",
    "quickInput.background": "#F0F0F4",
    "quickInput.foreground": "#1A1A2E",
    "notificationCenter.border": "#D5D7E3",
    "notifications.background": "#F0F0F4",
    "notifications.foreground": "#1A1A2E",
    "widget.shadow": "#00000022"
  },
  "tokenColors": [
    {
      "name": "Comment - generic",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6E7390", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment - generic",
      "scope": ["comment.block.documentation", "keyword.other.documentation"],
      "settings": { "foreground": "#5C6186", "fontStyle": "italic" }
    },
    {
      "name": "String - generic",
      "scope": ["string", "punctuation.definition.string"],
      "settings": { "foreground": "#2F9E44" }
    },
    {
      "name": "Character escape - generic",
      "scope": "constant.character.escape",
      "settings": { "foreground": "#0B7285" }
    },
    {
      "name": "Numeric / language constant - generic",
      "scope": ["constant.numeric", "constant.language", "constant.other"],
      "settings": { "foreground": "#E8590C" }
    },
    {
      "name": "Keyword control - generic",
      "scope": ["keyword.control", "keyword.control.conditional", "keyword.control.flow"],
      "settings": { "foreground": "#7C5CBF", "fontStyle": "bold" }
    },
    {
      "name": "Keyword operator - generic",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#0B7285" }
    },
    {
      "name": "Storage type/modifier - generic",
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#3B5BDB", "fontStyle": "italic" }
    },
    {
      "name": "Function name - generic",
      "scope": ["entity.name.function", "support.function"],
      "settings": { "foreground": "#1A6FB0" }
    },
    {
      "name": "Class / type name - generic",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
      "settings": { "foreground": "#0B7285", "fontStyle": "bold" }
    },
    {
      "name": "Tag name - generic (HTML/XML/JSX)",
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#C2255C" }
    },
    {
      "name": "Attribute name - generic",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#A36F00" }
    },
    {
      "name": "Variable - generic",
      "scope": ["variable"],
      "settings": { "foreground": "#33365B" }
    },
    {
      "name": "Variable parameter - generic",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#A36F00", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation - generic",
      "scope": ["punctuation"],
      "settings": { "foreground": "#6B6F84" }
    },
    {
      "name": "Markdown headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#3B5BDB", "fontStyle": "bold" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#E8590C", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#2F9E44", "fontStyle": "italic" }
    },
    {
      "name": "Markdown link",
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#3B5BDB", "fontStyle": "underline" }
    },
    {
      "name": "Invalid / illegal - generic",
      "scope": ["invalid.illegal"],
      "settings": { "foreground": "#C2255C", "background": "#FBDDE7" }
    },

    {
      "name": "BML - line/block comments",
      "scope": ["comment.line.double-slash.bml", "comment.block.bml"],
      "settings": { "foreground": "#6E7390", "fontStyle": "italic" }
    },
    {
      "name": "BML - documentation comments",
      "scope": ["comment.block.documentation.bml"],
      "settings": { "foreground": "#5C6186", "fontStyle": "italic" }
    },
    {
      "name": "BML - comment punctuation",
      "scope": [
        "punctuation.definition.comment.bml",
        "punctuation.definition.comment.begin.bml",
        "punctuation.definition.comment.end.bml"
      ],
      "settings": { "foreground": "#6E7390" }
    },
    {
      "name": "BML - strings",
      "scope": [
        "string.quoted.double.bml",
        "punctuation.definition.string.begin.bml",
        "punctuation.definition.string.end.bml"
      ],
      "settings": { "foreground": "#2F9E44" }
    },
    {
      "name": "BML - escape sequences",
      "scope": "constant.character.escape.bml",
      "settings": { "foreground": "#0B7285" }
    },
    {
      "name": "BML - numeric constants",
      "scope": "constant.numeric.bml",
      "settings": { "foreground": "#E8590C" }
    },
    {
      "name": "BML - language/other constants and storage type",
      "scope": ["constant.language.bml", "constant.other.bml", "storage.type.bml"],
      "settings": { "foreground": "#3B5BDB", "fontStyle": "bold" }
    },
    {
      "name": "BML - logical operator",
      "scope": "keyword.operator.logical.bml",
      "settings": { "foreground": "#0B7285", "fontStyle": "bold" }
    },
    {
      "name": "BML - arithmetic/comparison/assignment operators",
      "scope": [
        "keyword.operator.arithmetic.bml",
        "keyword.operator.comparison.bml",
        "keyword.operator.assignment.bml"
      ],
      "settings": { "foreground": "#0B7285" }
    },
    {
      "name": "BML - control flow/conditional keywords",
      "scope": ["keyword.control.conditional.bml", "keyword.control.flow.bml"],
      "settings": { "foreground": "#7C5CBF", "fontStyle": "bold" }
    },

    {
      "name": "BML - function (generic/user)",
      "scope": "entity.name.function.bml",
      "settings": { "foreground": "#1A6FB0" }
    },
    {
      "name": "BML - string functions",
      "scope": "entity.name.function.string.bml",
      "settings": { "foreground": "#2F9E44" }
    },
    {
      "name": "BML - math functions",
      "scope": "entity.name.function.math.bml",
      "settings": { "foreground": "#E8590C" }
    },
    {
      "name": "BML - date functions",
      "scope": "entity.name.function.date.bml",
      "settings": { "foreground": "#A36F00" }
    },
    {
      "name": "BML - database functions",
      "scope": "entity.name.function.database.bml",
      "settings": { "foreground": "#C2255C", "fontStyle": "bold" }
    },
    {
      "name": "BML - URL functions",
      "scope": "entity.name.function.url.bml",
      "settings": { "foreground": "#0B7285" }
    },
    {
      "name": "BML - array functions",
      "scope": "entity.name.function.array.bml",
      "settings": { "foreground": "#3B5BDB" }
    },
    {
      "name": "BML - dictionary functions",
      "scope": "entity.name.function.dictionary.bml",
      "settings": { "foreground": "#7C5CBF" }
    },
    {
      "name": "BML - XML/JSON functions",
      "scope": ["entity.name.function.xml.bml", "entity.name.function.json.bml"],
      "settings": { "foreground": "#1A6FB0", "fontStyle": "italic" }
    },
    {
      "name": "BML - misc functions",
      "scope": "entity.name.function.misc.bml",
      "settings": { "foreground": "#33365B" }
    },

    {
      "name": "BML - plain variables",
      "scope": "variable.other.bml",
      "settings": { "foreground": "#33365B" }
    },
    {
      "name": "BML - CPQ attribute/member access",
      "scope": [
        "variable.other.member.bml",
        "variable.other.line.attribute.bml",
        "variable.other.transaction.attribute.bml",
        "variable.other.property.bml"
      ],
      "settings": { "foreground": "#A36F00" }
    },
    {
      "name": "BML - constant variables",
      "scope": "variable.other.constant.bml",
      "settings": { "foreground": "#E8590C", "fontStyle": "bold" }
    },

    {
      "name": "BML - punctuation",
      "scope": [
        "punctuation.accessor.bml",
        "punctuation.separator.bml",
        "punctuation.section.arguments.begin.bml",
        "punctuation.section.arguments.end.bml",
        "punctuation.section.braces.begin.bml",
        "punctuation.section.braces.end.bml",
        "punctuation.section.brackets.begin.bml",
        "punctuation.section.brackets.end.bml",
        "punctuation.section.parens.begin.bml",
        "punctuation.section.parens.end.bml"
      ],
      "settings": { "foreground": "#6B6F84" }
    }
  ]
}
