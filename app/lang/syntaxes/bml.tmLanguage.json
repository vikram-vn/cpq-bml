{
  "information_for_contributors": [
    "This file has been converted from https://github.com/atom/language-java/blob/master/grammars/java.cson",
    "If you want to provide a fix or improvement, please create a pull request against the original repository.",
    "Once accepted there, we are happy to receive an update request."
  ],
  "version": "https://github.com/atom/language-java/commit/29f977dc42a7e2568b39bb6fb34c4ef108eb59b3",
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CPQ BML",
  "scopeName": "source.bml",
  "fileTypes": ["bml"],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.bml",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.bml"
            }
          },
          "patterns": [
            {
              "match": "@\\w+\\b",
              "name": "keyword.other.documentation.bml"
            }
          ]
        },
        {
          "name": "comment.block.bml",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.bml"
            }
          }
        },
        {
          "name": "comment.line.double-slash.bml",
          "match": "//.*",
          "captures": {
            "0": {
              "name": "punctuation.definition.comment.bml"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bml",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.bml"
            }
          },
          "patterns": [
            {
              "match": "\\\\([\"\\\\bfnrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.bml"
            },
            {
              "match": "\\$_(access_token_salesforce|access_token_dynamics365|access_token_oauthprovider)\\$",
              "name": "variable.other.constant.bml"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bml",
          "match": "\\b((0(x|X)[0-9a-fA-F]+)|(\\d+(\\.\\d+)?([eE][+-]?\\d+)?))\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.bml",
          "match": "(?i)\\b(if|elif|else)\\b"
        },
        {
          "name": "keyword.control.flow.bml",
          "match": "(?i)\\b(for|in|break|continue|return)\\b"
        },
        {
          "name": "constant.language.bml",
          "match": "(?i)\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.logical.bml",
          "match": "(?i)\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.bml",
          "match": "(?i)\\b(String|Integer|Float|Boolean|Date|Json|JsonArray|JsonNull|ByteArray|Record|RecordSet|StringBuilder|Dictionary|dict)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.bml",
          "match": "(?i)\\b(NaN|jNaN)\\b"
        },
        {
          "name": "constant.other.bml",
          "match": "\\$BM_UNCHANGED_(NUM|STR|DATE)\\$"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_REASON_STATUS_(INVALID|INACTIVE|PENDING|APPROVED|REJECTED)"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_REMOTE_APPROVAL_STATUS_(APPROVED|REJECTED|CUSTOM)"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_CM_RULES_(MESSAGE|LOCATION|OPERATOR|VALUES)"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_PARTNER_SECURITY_TOKEN|BM_DEFAULT_SOURCE_IDENTIFIER|BM_SALES_ROOT_BOM|BM_PRIOR_ROOT_BOM_ITEM|BM_PRIOR_CONFIGURATION_KEY|BM_CONFIGURATION_KEY"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.bml",
          "match": "[+\\-*/%]"
        },
        {
          "name": "keyword.operator.comparison.bml",
          "match": "==|!=|<=|>=|<>|<|>"
        },
        {
          "name": "keyword.operator.assignment.bml",
          "match": "="
        },
        {
          "name": "punctuation.section.parens.begin.bml",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.bml",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.bml",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.bml",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.bml",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.bml",
          "match": "\\}"
        },
        {
          "name": "punctuation.accessor.bml",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.bml",
          "match": "[,;:]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "entity.name.function.string.bml",
          "match": "(?i)\\b(atof|atoi|decodebase64|encodebase64|endswith|find|formatascurrency|getcurrencyvalue|html|isnumber|join|len|lower|replace|split|startswith|string|substring|trim|upper|format)\\b"
        },
        {
          "name": "entity.name.function.math.bml",
          "match": "(?i)\\b(acos|asin|atan|ceil|cos|cosh|exp|fabs|fmod|hypot|integer|ln|log|pow|round|sin|sinh|sqrt|tan|tanh|abs)\\b"
        },
        {
          "name": "entity.name.function.date.bml",
          "match": "(?i)\\b(adddays|addmonths|comparedates|datetostr|getdate|getdiffindays|getstrdate|isleap|isweekend|minusdays|strtodate|strtojavadate|getcurrenttimeinmillis|formatdate)\\b"
        },
        {
          "name": "entity.name.function.database.bml",
          "match": "(?i)\\b(bmql|getboolean|getdate|getfloat|getint|getmessage|getpartsdata|gettabledata|gettransaction|haserror|recordset)\\b"
        },
        {
          "name": "entity.name.function.url.bml",
          "match": "(?i)\\b(makeurlparam|urldata|urldatabyget|urldatabypost|urldatabypostasync|urlmultipartbypost)\\b"
        },
        {
          "name": "entity.name.function.array.bml",
          "match": "(?i)\\b(append|bytearray|findinarray|isempty|max|min|range|remove|reverse|sizeofarray|sort|indexof|slice)\\b"
        },
        {
          "name": "entity.name.function.dictionary.bml",
          "match": "(?i)\\b(dict|containskey|get|keys|put|values)\\b"
        },
        {
          "name": "entity.name.function.xml.bml",
          "match": "(?i)\\b(applytemplate|readxmlsingle|readxmlmultiple|transformxml)\\b"
        },
        {
          "name": "entity.name.function.json.bml",
          "match": "(?i)\\b(json|jsonarray|jsonarrayappend|jsonarraycopy|jsonarrayget|jsonarrayrefid|jsonarrayremove|jsonarraysize|jsonarraytostr|jsoncopy|jsonget|jsonkeys|jsonnull|jsonpathcheck|jsonpathremove|jsonpathset|jsonpathgetsingle|jsonpathgetmultiple|jsonput|jsonremove|isjsonnull|jsontostr)\\b"
        },
        {
          "name": "entity.name.function.misc.bml",
          "match": "(?i)\\b(addtotransaction|sbappend|sbtostring|addpartstotransaction|applybom|calculatedeltabom|calculateconfiguration|configureabo|convertbomtohier|convertbomtoflat|generateuuid|generatehmacmessage|getattachmentdata|getarrayattrstring|getbom|getconfigattrvalue|getconfigbom|getcoveragesupportdict|getoldvalue|getreasonstatus|getsystemattrvalues|getsystemdata|getsystemmultipleattrvalues|getuuid|globaldictget|globaldictremove|globaldictset|importtransactiondata|isnull|logtime|print|savebom|saveconfigbom|setattributevalue|throwerror|validatequoteforagreement|usersessionget|usersessionremove|usersessionset)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.bml",
          "begin": "([a-zA-Z_]\\w*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.bml"
            },
            "2": {
              "name": "punctuation.section.arguments.begin.bml"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.bml"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.method-call.bml",
          "begin": "(\\.[a-zA-Z_]\\w*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.bml"
            },
            "2": {
              "name": "punctuation.section.arguments.begin.bml"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.bml"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "variable.other.member.bml",
          "match": "\\b_[a-zA-Z0-9_]+\\b"
        },
        {
          "name": "variable.other.line.attribute.bml",
          "match": "\\b(line\\.[a-zA-Z0-9_]+(?:_[cl]))\\b",
          "comment": "Matches line item attributes (suffixes _c or _l)"
        },
        {
          "name": "variable.other.transaction.attribute.bml",
          "match": "\\b([a-zA-Z0-9_]+(?:_[ctl]))\\b",
          "comment": "Matches transaction and transaction-line attributes (suffixes _c, _t, or _l), with or without a dot prefix"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\bCRM_[A-Z_]+\\b",
          "comment": "CRM system variables (e.g. CRM_CUSTOMER_ID) - per app/lang/intellisense/bml_util_attributes_api_usage.json, these don't follow the usual leading-underscore or _c/_t/_l suffix conventions"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\boRCL_[a-zA-Z]+\\b",
          "comment": "ORCL_* system variables (e.g. oRCL_charges) - per app/lang/intellisense/bml_attributes_api_usage.json"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\b(bs_id|createOrderRestResponse|includedInBasePrice)\\b",
          "comment": "Remaining known system variables/attributes from app/lang/intellisense that don't follow any naming convention"
        },
        {
          "name": "variable.other.property.bml",
          "match": "(?<=\\.)[a-zA-Z_]\\w*"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.bml",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    }
  }
}
