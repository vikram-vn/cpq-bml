{
  "information_for_contributors": [
    "CPQ BML (BigMachines Language) TextMate Syntax Grammar for syntax highlighting."
  ],
  "version": "1.32.0",
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "CPQ BML",
  "scopeName": "source.bml",
  "fileTypes": [
    "bml"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#bmql-function-calls"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#function-calls"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.bml",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.bml"
            }
          },
          "patterns": [
            {
              "match": "@(param|return|returns|throws|author|version|deprecated|description|example|see|since|input|output)\\b",
              "name": "keyword.other.documentation.bml"
            }
          ]
        },
        {
          "name": "comment.block.bml",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.bml"
            }
          },
          "patterns": [
            {
              "match": "\\b(beautify ignore:(start|end))\\b",
              "name": "keyword.other.directive.bml"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.bml",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.bml"
            }
          },
          "patterns": [
            {
              "match": "\\b(bml-lint-disable(-line|-next-line)?)\\b",
              "name": "keyword.other.directive.bml"
            },
            {
              "match": "\\b(TODO|FIXME|BUG|HACK|NOTE|WARNING|XXX)\\b",
              "name": "storage.type.class.todo.bml"
            }
          ]
        }
      ]
    },
    "bmql-function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.bmql.bml",
          "begin": "(?i)\\b(bmql)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.database.bml"
            },
            "2": {
              "name": "punctuation.section.arguments.begin.bml"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.bml"
            }
          },
          "patterns": [
            {
              "include": "#bmql-strings"
            },
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "bmql-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bmql.bml",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.bml"
            }
          },
          "patterns": [
            {
              "match": "\\\\([\"\\\\bfnrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.bml"
            },
            {
              "match": "\\$([a-zA-Z_]\\w*)",
              "name": "variable.other.bmql.bml"
            },
            {
              "match": "(?i)(?<![\\w-])(SELECT|DISTINCT|FROM|WHERE|ORDER BY|GROUP BY|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|MODIFY|ASC|DESC|JOIN|INNER JOIN|LEFT JOIN|RIGHT JOIN|IN|AND|OR|LIKE|NOT|IS|NULL|BETWEEN|LIMIT|HAVING)(?![\\w-])",
              "name": "keyword.other.bmql.bml"
            }
          ]
        },
        {
          "name": "string.quoted.single.bmql.bml",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.bml"
            }
          },
          "patterns": [
            {
              "match": "\\\\(['\\\\bfnrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.bml"
            },
            {
              "match": "\\$([a-zA-Z_]\\w*)",
              "name": "variable.other.bmql.bml"
            },
            {
              "match": "(?i)(?<![\\w-])(SELECT|DISTINCT|FROM|WHERE|ORDER BY|GROUP BY|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|MODIFY|ASC|DESC|JOIN|INNER JOIN|LEFT JOIN|RIGHT JOIN|IN|AND|OR|LIKE|NOT|IS|NULL|BETWEEN|LIMIT|HAVING)(?![\\w-])",
              "name": "keyword.other.bmql.bml"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.bml",
          "begin": "\"",
          "end": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.bml"
            }
          },
          "patterns": [
            {
              "match": "\\\\([\"\\\\bfnrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.bml"
            },
            {
              "match": "\\$_(access_token_salesforce|access_token_dynamics365|access_token_oauthprovider|BM_ASYNC_ADDRESSING_TOKEN|BM_ASYNC_PAYLOAD)\\$",
              "name": "variable.other.constant.bml"
            },
            {
              "match": "\\$(BASE_PATH|LINE)\\$",
              "name": "variable.other.constant.bml"
            },
            {
              "match": "\\$([a-zA-Z_]\\w*)",
              "name": "variable.other.bmql.bml",
              "comment": "BMQL variable substitution inside query strings (e.g. $pno, $lead, $eval)"
            },
            {
              "match": "(?<![\\w-])(SELECT|DISTINCT|FROM|WHERE|ORDER BY|GROUP BY|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|MODIFY|ASC|DESC|JOIN|INNER JOIN|LEFT JOIN|RIGHT JOIN)(?![\\w-])",
              "name": "keyword.other.bmql.bml",
              "comment": "BMQL SQL query keywords (uppercase only for general strings)"
            }
          ]
        },
        {
          "name": "string.quoted.single.bml",
          "begin": "'",
          "end": "'",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.bml"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.bml"
            }
          },
          "patterns": [
            {
              "match": "\\\\(['\\\\bfnrt]|u[0-9a-fA-F]{4})",
              "name": "constant.character.escape.bml"
            },
            {
              "match": "\\$([a-zA-Z_]\\w*)",
              "name": "variable.other.bmql.bml"
            },
            {
              "match": "(?<![\\w-])(SELECT|DISTINCT|FROM|WHERE|ORDER BY|GROUP BY|INSERT INTO|VALUES|UPDATE|SET|DELETE FROM|MODIFY|ASC|DESC|JOIN|INNER JOIN|LEFT JOIN|RIGHT JOIN)(?![\\w-])",
              "name": "keyword.other.bmql.bml",
              "comment": "BMQL SQL query keywords (uppercase only for general strings)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.bml",
          "match": "\\b((0(x|X)[0-9a-fA-F]+)|(\\d+(\\.\\d+)?([eE][+-]?\\d+)?))\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.bml",
          "match": "(?i)\\b(if|elif|else)\\b"
        },
        {
          "name": "keyword.control.flow.bml",
          "match": "(?i)\\b(for|in|break|continue|return|throwerror|print)\\b"
        },
        {
          "name": "constant.language.bml",
          "match": "(?i)\\b(true|false|null)\\b"
        },
        {
          "name": "keyword.operator.logical.bml",
          "match": "(?i)\\b(and|or|not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.bml",
          "match": "(?i)\\b(String|Integer|Float|Boolean|Date|Json|JsonArray|JsonNull|ByteArray|Record|RecordSet|StringBuilder|Dictionary|dict)(?:\\[\\])*(?:<(?:string|integer|float|boolean|date|anytype|dict<anytype>)>)?\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.bml",
          "match": "(?i)\\b(NaN|jNaN)\\b"
        },
        {
          "name": "constant.other.bml",
          "match": "\\$BM_UNCHANGED_(NUM|STR|DATE)\\$"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_REASON_STATUS_(INVALID|INACTIVE|PENDING|APPROVED|REJECTED)"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_REMOTE_APPROVAL_STATUS_(APPROVED|REJECTED|CUSTOM)"
        },
        {
          "name": "constant.other.bml",
          "match": "BM_CM_RULES_(MESSAGE|LOCATION|OPERATOR|VALUES)"
        },
        {
          "name": "constant.other.bml",
          "match": "\\b(BM_PARTNER_SECURITY_TOKEN|BM_DEFAULT_SOURCE_IDENTIFIER|BM_SALES_ROOT_BOM|BM_SALES_ROOT_BOM_ITEM|BM_PRIOR_ROOT_BOM_ITEM|BM_PRIOR_CONFIGURATION_KEY|BM_CONFIGURATION_KEY)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arithmetic.bml",
          "match": "[+\\-*/%~]"
        },
        {
          "name": "keyword.operator.comparison.bml",
          "match": "==|!=|<=|>=|<>|<|>"
        },
        {
          "name": "keyword.operator.assignment.bml",
          "match": "="
        },
        {
          "name": "punctuation.section.parens.begin.bml",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.bml",
          "match": "\\)"
        },
        {
          "name": "punctuation.section.brackets.begin.bml",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.bml",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.braces.begin.bml",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.bml",
          "match": "\\}"
        },
        {
          "name": "punctuation.accessor.bml",
          "match": "\\."
        },
        {
          "name": "punctuation.separator.bml",
          "match": "[,;:]"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "entity.name.function.string.bml",
          "match": "(?i)\\b(atof|atoi|decodebase64|encodebase64|endswith|find|formatascurrency|getcurrencyvalue|html|isnumber|join|len|lower|replace|split|startswith|string|substring|trim|upper|format|stringbuilder|sbtostring|sbappend)\\b"
        },
        {
          "name": "entity.name.function.math.bml",
          "match": "(?i)\\b(acos|asin|atan|ceil|cos|cosh|exp|fabs|fmod|hypot|integer|float|ln|log|pow|round|sin|sinh|sqrt|tan|tanh|abs)\\b"
        },
        {
          "name": "entity.name.function.date.bml",
          "match": "(?i)\\b(adddays|addmonths|comparedates|datetostr|date|getdate|getdiffindays|getstrdate|isleap|isweekend|minusdays|strtodate|strtojavadate|getcurrenttimeinmillis|formatdate)\\b"
        },
        {
          "name": "entity.name.function.database.bml",
          "match": "(?i)\\b(bmql|getboolean|getdate|getfloat|getint|getmessage|getpartsdata|gettabledata|gettransaction|haserror|recordset)\\b"
        },
        {
          "name": "entity.name.function.url.bml",
          "match": "(?i)\\b(makeurlparam|urldata|urldatabyget|urldatabypost|urldatabypostasync|urlmultipartbypost)\\b"
        },
        {
          "name": "entity.name.function.array.bml",
          "match": "(?i)\\b(append|bytearray|findinarray|isempty|max|min|range|remove|reverse|sizeofarray|sort|indexof|slice)\\b"
        },
        {
          "name": "entity.name.function.dictionary.bml",
          "match": "(?i)\\b(dict|containskey|get|keys|put|values)\\b"
        },
        {
          "name": "entity.name.function.xml.bml",
          "match": "(?i)\\b(applytemplate|readxmlsingle|readxmlmultiple|transformxml)\\b"
        },
        {
          "name": "entity.name.function.json.bml",
          "match": "(?i)\\b(json|jsonarray|jsonarrayappend|jsonarraycopy|jsonarrayget|jsonarrayrefid|jsonarrayremove|jsonarraysize|jsonarraytostr|jsoncopy|jsonget|jsonkeys|jsonnull|jsonpathcheck|jsonpathremove|jsonpathset|jsonpathgetsingle|jsonpathgetmultiple|jsonput|jsonremove|isjsonnull|jsontostr)\\b"
        },
        {
          "name": "entity.name.function.misc.bml",
          "match": "(?i)\\b(addtotransaction|addpartstotransaction|applybom|calculatedeltabom|calculateconfiguration|configureabo|convertbomtohier|convertbomtoflat|generateuuid|generatehmacmessage|getattachmentdata|getarrayattrstring|getbom|getconfigattrvalue|getconfigbom|getcoveragesupportdict|getoldvalue|getreasonstatus|getsystemattrvalues|getsystemdata|getsystemmultipleattrvalues|getuuid|globaldictget|globaldictremove|globaldictset|importtransactiondata|isnull|logtime|print|savebom|saveconfigbom|setattributevalue|throwerror|validatequoteforagreement|usersessionget|usersessionremove|usersessionset)\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "meta.function-call.bml",
          "begin": "([a-zA-Z_]\\w*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.bml"
            },
            "2": {
              "name": "punctuation.section.arguments.begin.bml"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.bml"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        },
        {
          "name": "meta.method-call.bml",
          "begin": "(\\.)([a-zA-Z_]\\w*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "punctuation.accessor.bml"
            },
            "2": {
              "name": "entity.name.function.member.bml"
            },
            "3": {
              "name": "punctuation.section.arguments.begin.bml"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.arguments.end.bml"
            }
          },
          "patterns": [
            {
              "include": "$self"
            }
          ]
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "variable.other.system.bml",
          "match": "\\b_(BM_USER_[A-Z_]+|system_[a-zA-Z0-9_]+|config_[a-zA-Z0-9_]+|bm_[a-zA-Z0-9_]+)\\b",
          "comment": "System context variables (_BM_USER_*, _system_*, _config_*, _bm_*)"
        },
        {
          "name": "variable.other.line.attribute.bml",
          "match": "\\bline\\._[a-zA-Z0-9_]+\\b",
          "comment": "Matches line item system attributes e.g. line._document_number"
        },
        {
          "name": "variable.other.line.attribute.bml",
          "match": "\\bline\\.[a-zA-Z0-9_]+(?:_[ctl])?\\b",
          "comment": "Matches line item custom/standard attributes"
        },
        {
          "name": "variable.other.transaction.attribute.bml",
          "match": "\\b([a-zA-Z0-9_]+(?:_[ctl]))\\b",
          "comment": "Matches transaction and commerce attributes with suffix _c, _t, or _l"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\b_[a-zA-Z0-9_]+\\b",
          "comment": "Matches system attributes with leading underscore (e.g. _document_number, _price_quantity)"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\bCRM_[A-Z0-9_]+\\b",
          "comment": "CRM system variables (e.g. CRM_CUSTOMER_ID, CRM_BUYER_COMPANY)"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\b(?:oRCL|ORCL)_[a-zA-Z0-9_]+\\b",
          "comment": "ORCL_* system integration variables"
        },
        {
          "name": "variable.other.member.bml",
          "match": "\\b(bs_id|createOrderRestResponse|includedInBasePrice|records_inserted|records_updated|records_deleted|records_error)\\b",
          "comment": "System attributes and BMQL result keys"
        },
        {
          "match": "(\\.)\\s*([a-zA-Z_]\\w*)",
          "captures": {
            "1": {
              "name": "punctuation.accessor.bml"
            },
            "2": {
              "name": "variable.other.property.bml"
            }
          }
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.bml",
          "match": "\\b[a-zA-Z_]\\w*\\b"
        }
      ]
    }
  }
}
