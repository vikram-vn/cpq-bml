{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "XSLT",
  "scopeName": "source.xsl",
  "fileTypes": ["xsl", "xslt"],
  "patterns": [
    { "include": "#xml-declaration" },
    { "include": "#doctype" },
    { "include": "#comment" },
    { "include": "#cdata" },
    { "include": "#xsl-element" },
    { "include": "#xml-element" }
  ],
  "repository": {
    "xml-declaration": {
      "name": "meta.tag.preprocessor.xml",
      "begin": "(<\\?)(xml)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.xml" },
        "2": { "name": "entity.name.tag.xml" }
      },
      "end": "(\\?>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.xml" }
      },
      "patterns": [{ "include": "#attribute" }]
    },

    "doctype": {
      "name": "meta.tag.sgml.doctype.xml",
      "begin": "<!DOCTYPE",
      "beginCaptures": { "0": { "name": "entity.name.tag.doctype.xml" } },
      "end": ">",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.xml" } },
      "patterns": [
        {
          "name": "string.quoted.double.xml",
          "begin": "\"",
          "end": "\""
        }
      ]
    },

    "comment": {
      "name": "comment.block.xml",
      "begin": "<!--",
      "beginCaptures": { "0": { "name": "punctuation.definition.comment.xml" } },
      "end": "-->",
      "endCaptures": { "0": { "name": "punctuation.definition.comment.xml" } }
    },

    "cdata": {
      "name": "string.unquoted.cdata.xml",
      "begin": "<!\\[CDATA\\[",
      "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.xml" } },
      "end": "\\]\\]>",
      "endCaptures": { "0": { "name": "punctuation.definition.string.end.xml" } }
    },

    "xsl-element": {
      "patterns": [
        { "include": "#xsl-template" },
        { "include": "#xsl-instruction" },
        { "include": "#xsl-self-closing" }
      ]
    },

    "xsl-template": {
      "name": "meta.tag.block.xsl",
      "begin": "(<)(xsl:(?:stylesheet|transform|template|function|variable|param|key|decimal-format|namespace-alias|import|include|output|strip-space|preserve-space|attribute-set|character-map|output-character))(\\s|>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xsl keyword.control.xsl" },
        "3": { "name": "punctuation.definition.tag.xml" }
      },
      "end": "(</)(xsl:[a-zA-Z-]+)(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.xml" },
        "2": { "name": "entity.name.tag.xsl keyword.control.xsl" },
        "3": { "name": "punctuation.definition.tag.xml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#xpath-attr-value" },
        { "include": "#comment" },
        { "include": "#cdata" },
        { "include": "#xsl-element" },
        { "include": "#xml-element" }
      ]
    },

    "xsl-instruction": {
      "name": "meta.tag.inline.xsl",
      "begin": "(<)(xsl:(?:apply-templates|apply-imports|call-template|with-param|sort|copy|copy-of|value-of|for-each|for-each-group|if|choose|when|otherwise|element|attribute|text|comment|processing-instruction|number|message|fallback|next-match|perform-sort|sequence|result-document|analyze-string|matching-substring|non-matching-substring|iterate|break|on-completion|try|catch|next-iteration|merge|merge-source|merge-key|on-empty|on-not-empty|where-populated))(\\s|>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xsl keyword.other.xsl" },
        "3": { "name": "punctuation.definition.tag.xml" }
      },
      "end": "(/>|(?:</)(?:xsl:[a-zA-Z-]+)(>))",
      "endCaptures": {
        "0": { "name": "punctuation.definition.tag.xml" }
      },
      "patterns": [
        { "include": "#attribute" },
        { "include": "#xpath-attr-value" },
        { "include": "#comment" },
        { "include": "#cdata" },
        { "include": "#xsl-element" },
        { "include": "#xml-element" }
      ]
    },

    "xsl-self-closing": {
      "name": "meta.tag.inline.xsl",
      "match": "(<)(xsl:[a-zA-Z-]+)([^>]*/?>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xsl keyword.other.xsl" },
        "3": { "name": "punctuation.definition.tag.xml" }
      }
    },

    "xml-element": {
      "patterns": [
        { "include": "#xml-open-tag" },
        { "include": "#xml-close-tag" },
        { "include": "#xml-self-closing-tag" }
      ]
    },

    "xml-open-tag": {
      "name": "meta.tag.xml",
      "begin": "(<)([a-zA-Z_][a-zA-Z0-9_:.-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xml" }
      },
      "end": "(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.end.xml" }
      },
      "patterns": [{ "include": "#attribute" }]
    },

    "xml-close-tag": {
      "name": "meta.tag.xml",
      "match": "(</)((?:[a-zA-Z_][a-zA-Z0-9_:.-]*))(>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xml" },
        "3": { "name": "punctuation.definition.tag.end.xml" }
      }
    },

    "xml-self-closing-tag": {
      "name": "meta.tag.xml",
      "match": "(<)([a-zA-Z_][a-zA-Z0-9_:.-]*)([^>]*/?>)",
      "captures": {
        "1": { "name": "punctuation.definition.tag.begin.xml" },
        "2": { "name": "entity.name.tag.xml" },
        "3": { "name": "punctuation.definition.tag.end.xml" }
      }
    },

    "attribute": {
      "patterns": [
        { "include": "#attribute-with-xpath" },
        { "include": "#attribute-plain" }
      ]
    },

    "attribute-with-xpath": {
      "comment": "XSL attributes that contain XPath expressions",
      "name": "meta.attribute.xpath.xsl",
      "match": "(?x)\n  \\b(select|test|match|use|by|count|from|value|name|namespace|group-by|group-adjacent|group-starting-with|group-ending-with|key|use-attribute-sets|href|format|lang|letter-value|grouping-separator|grouping-size|decimal-separator|minus-sign|percent|per-mille|zero-digit|digit|pattern-separator|order|case-order|data-type|as|xpath)\\s*(=)\\s*(\"([^\"]*)\"|'([^']*)')",
      "captures": {
        "1": { "name": "entity.other.attribute-name.xsl support.type.property-name.xsl" },
        "2": { "name": "punctuation.separator.key-value.xml" },
        "3": { "name": "string.quoted.xsl" },
        "4": { "name": "source.xpath", "patterns": [{ "include": "#xpath" }] },
        "5": { "name": "source.xpath", "patterns": [{ "include": "#xpath" }] }
      }
    },

    "attribute-plain": {
      "name": "meta.attribute.xml",
      "match": "([a-zA-Z_][a-zA-Z0-9_:.-]*)\\s*(=)\\s*(\"[^\"]*\"|'[^']*')",
      "captures": {
        "1": { "name": "entity.other.attribute-name.xml" },
        "2": { "name": "punctuation.separator.key-value.xml" },
        "3": { "name": "string.quoted.double.xml" }
      }
    },

    "xpath-attr-value": {
      "comment": "Inline AVT {expressions} in attribute values",
      "name": "meta.embedded.xpath.xsl",
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.section.embedded.begin.xsl" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.section.embedded.end.xsl" } },
      "patterns": [{ "include": "#xpath" }]
    },

    "xpath": {
      "patterns": [
        { "include": "#xpath-function" },
        { "include": "#xpath-axis" },
        { "include": "#xpath-operator" },
        { "include": "#xpath-predicate" },
        { "include": "#xpath-string" },
        { "include": "#xpath-number" },
        { "include": "#xpath-variable" },
        { "include": "#xpath-node-type" }
      ]
    },

    "xpath-function": {
      "name": "support.function.xpath",
      "match": "(?x)\\b(abs|adjust-date-to-timezone|adjust-dateTime-to-timezone|adjust-time-to-timezone|avg|base-uri|boolean|ceiling|codepoint-equal|codepoints-to-string|collection|compare|concat|contains|count|current|current-date|current-dateTime|current-group|current-grouping-key|current-time|data|date|dateTime|day-from-date|day-from-dateTime|days-from-duration|deep-equal|default-collation|distinct-values|doc|doc-available|document|document-uri|element-available|empty|encode-for-uri|ends-with|error|escape-html-uri|exactly-one|exists|false|floor|format-date|format-dateTime|format-number|format-time|function-available|generate-id|hours-from-dateTime|hours-from-duration|hours-from-time|id|idref|implicit-timezone|in-scope-prefixes|index-of|insert-before|iri-to-uri|key|lang|last|local-name|local-name-from-QName|lower-case|matches|max|min|minutes-from-dateTime|minutes-from-duration|minutes-from-time|month-from-date|month-from-dateTime|months-from-duration|name|namespace-uri|namespace-uri-for-prefix|namespace-uri-from-QName|nilled|node-name|normalize-space|normalize-unicode|not|number|one-or-more|position|prefix-from-QName|QName|remove|replace|resolve-QName|resolve-uri|reverse|root|round|round-half-to-even|seconds-from-dateTime|seconds-from-duration|seconds-from-time|starts-with|static-base-uri|string|string-join|string-length|string-to-codepoints|subsequence|substring|substring-after|substring-before|sum|system-property|timezone-from-date|timezone-from-dateTime|timezone-from-time|tokenize|trace|translate|true|unordered|upper-case|uri-collection|unparsed-entity-uri|unparsed-entity-public-id|unparsed-text|unparsed-text-available|year-from-date|year-from-dateTime|years-from-duration|zero-or-one)\\s*(?=\\()"
    },

    "xpath-axis": {
      "name": "keyword.operator.xpath.axis",
      "match": "\\b(ancestor|ancestor-or-self|attribute|child|descendant|descendant-or-self|following|following-sibling|namespace|parent|preceding|preceding-sibling|self)::"
    },

    "xpath-operator": {
      "name": "keyword.operator.xpath",
      "match": "\\b(and|or|mod|div|idiv|instance\\s+of|treat\\s+as|castable\\s+as|cast\\s+as|eq|ne|lt|le|gt|ge|is|to|in|return|for|some|every|if|then|else|satisfies|union|intersect|except)\\b|[\\|\\+\\-\\*\\=\\!\\<\\>\\[\\]@\\/\\.,]"
    },

    "xpath-predicate": {
      "name": "meta.structure.predicate.xpath",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.section.predicate.begin.xpath" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.section.predicate.end.xpath" } },
      "patterns": [{ "include": "#xpath" }]
    },

    "xpath-string": {
      "patterns": [
        {
          "name": "string.quoted.double.xpath",
          "match": "\"[^\"]*\""
        },
        {
          "name": "string.quoted.single.xpath",
          "match": "'[^']*'"
        }
      ]
    },

    "xpath-number": {
      "name": "constant.numeric.xpath",
      "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
    },

    "xpath-variable": {
      "name": "variable.other.xpath",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_.-]*"
    },

    "xpath-node-type": {
      "name": "support.type.xpath.node",
      "match": "\\b(node|text|comment|processing-instruction|element|attribute|document-node|schema-element|schema-attribute|item|empty-sequence)\\s*(?=\\()"
    }
  }
}
